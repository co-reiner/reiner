    "react": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "devDependencies": {
    "@co-reiner/exchange-packs": "workspace:^",
    "@co-reiner/harness-ms": "workspace:^"
  }
